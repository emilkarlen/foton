[act]

@ BIN_EXE -r --min-num-width 4 @[DIR]@

[setup]

def string DIR = the-dir

dir @[DIR]@ =
{
  file a.ext1
  file a.ext2
  file b.ext
  dir a =
  {
    file a.ext1
    file b.ext
    file c.ext
  }
}

[assert]

stdout equals @[REPORT]@

dir-contents . : matches -full
{
  @[DIR]@ : type dir && dir-contents matches -full @[DIR_CONTENTS_AFTER_RENAME]@
}

[before-assert]

def string REPORT =
<<EOF
@[DIR]@: a.ext1 -> 0001.ext1
@[DIR]@: a.ext2 -> 0001.ext2
@[DIR]@: b.ext -> 0002.ext
@[DIR]@/a: a.ext1 -> 0003.ext1
@[DIR]@/a: b.ext -> 0004.ext
@[DIR]@/a: c.ext -> 0005.ext
EOF

def files-condition DIR_CONTENTS_AFTER_RENAME =
{
 0001.ext1 : type file
 0001.ext2 : type file
 0002.ext  : type file
 a : type dir && dir-contents matches -full
 {
    0003.ext1 : type file
    0004.ext  : type file
    0005.ext  : type file
 }
}
