[act]

@ BIN src-dir dst-dir

[assert]

stdout equals
<<EOF
rm 'dst-dir/d1'.*
rm 'dst-dir/d2'.*
rm 'dst-dir/sub-dir/d1'.*
rm 'dst-dir/sub-dir/d2'.*
EOF

[setup]

dir src-dir =
{
  dir sub-dir =
  {
    file s1.ext
    file s2.ext
  }
  file s1.ext
  file s3.ext
}

dir dst-dir =
{
  dir sub-dir =
  {
    file d1.ext
    file d2.ext
  }
  file d1.ext
  file d2.ext
}
