[act]

@ BIN_EXE --move @[MOV_DIR]@  @[EXTRA_OPTIONS]@  @[SRC_DIR]@ @[DST_DIR]@

[setup]

dir @[MOV_DIR]@

[assert]

stdout @[REPORT_MATCHER_mv_nr_es]@

dir-contents . : matches -full
{
  @[SRC_DIR]@ : type dir && dir-contents matches -full @[SRC_DIR_CONTENTS]@
  @[DST_DIR]@ : type dir && dir-contents matches -full @[DST_DIR_CONTENTS_after_nr_es]@
  @[MOV_DIR]@ : type dir && dir-contents matches -full @[MOV_DIR_CONTENTS_after_nr_es]@
}
