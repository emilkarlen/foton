[act]

@ BIN_EXE -r  @[EXTRA_OPTIONS]@  @[SRC_DIR]@ @[DST_DIR]@

[assert]

stdout @[REPORT_MATCHER_rm_r]@

dir-contents . : matches -full
{
  @[SRC_DIR]@ : type dir && dir-contents matches -full @[SRC_DIR_CONTENTS]@
  @[DST_DIR]@ : type dir && dir-contents matches -full @[DST_DIR_CONTENTS_after_r]@
}
