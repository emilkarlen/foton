[act]

@ BIN_DRY -r --move @[MOV_DIR]@ @[SRC_DIR]@ @[DST_DIR]@

[setup]

dir @[MOV_DIR]@

[assert]

stdout @[STDOUT_mv]@

dir-contents . : matches -full
{
  @[SRC_DIR]@ : type dir && dir-contents matches -full @[SRC_DIR_CONTENTS]@
  @[DST_DIR]@ : type dir && dir-contents matches -full @[DST_DIR_before]@
  @[MOV_DIR]@ : type dir && dir-contents matches -full @[MOV_DIR_before]@
}
