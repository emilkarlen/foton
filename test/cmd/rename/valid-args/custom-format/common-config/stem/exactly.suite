[cases]

*.case

[setup]

including ../common.xly

def list FORMAT_ARGS = --format '{stem}-{stem}'

dir @[DIR]@ = @[COMMON_DIR_CONTENTS]@


[assert]

exit-code == 0

stderr is-empty

stdout equals @[REPORT]@


[before-assert]

def string REPORT =
<<EOF
@[DIR]@: a.ext1 -> a-a.ext1
@[DIR]@: a.ext2 -> a-a.ext2
@[DIR]@: b.ext1 -> b-b.ext1
@[DIR]@: b.ext2 -> b-b.ext2
@[DIR]@/a: a.ext1 -> a-a.ext1
@[DIR]@/a: b.ext -> b-b.ext
@[DIR]@/a: c.ext -> c-c.ext
EOF

def files-condition DIR_CONTENTS_after =
{
 a-a.ext1 : type file
 a-a.ext2 : type file
 b-b.ext1 : type file
 b-b.ext2 : type file
 a : type dir && dir-contents matches -full
 {
   a-a.ext1 : type file
   b-b.ext  : type file
   c-c.ext  : type file
 }
}
