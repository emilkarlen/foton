[cases]

*.case

[setup]

including ../common.xly

def list FORMAT_ARGS = --format 'pfx-{NN}' --min-num-width 4 --start-num 8

dir @[DIR]@ = @[COMMON_DIR_CONTENTS]@


[assert]

exit-code == 0

stderr is-empty


[before-assert]

def string REPORT_nr =
<<EOF
@[DIR]@: a.ext1 -> pfx-0008.ext1
@[DIR]@: a.ext2 -> pfx-0008.ext2
@[DIR]@: b.ext1 -> pfx-0009.ext1
@[DIR]@: b.ext2 -> pfx-0009.ext2
EOF

def string REPORT_r =
<<EOF
@[DIR]@: a.ext1 -> pfx-0008.ext1
@[DIR]@: a.ext2 -> pfx-0008.ext2
@[DIR]@: b.ext1 -> pfx-0009.ext1
@[DIR]@: b.ext2 -> pfx-0009.ext2
@[DIR]@/a: a.ext1 -> pfx-0010.ext1
@[DIR]@/a: b.ext -> pfx-0011.ext
@[DIR]@/a: c.ext -> pfx-0012.ext
EOF

def files-condition DIR_CONTENTS_after_r =
{
 pfx-0008.ext1 : type file
 pfx-0008.ext2 : type file
 pfx-0009.ext1 : type file
 pfx-0009.ext2 : type file
 a : type dir && dir-contents matches -full
 {
   pfx-0010.ext1 : type file
   pfx-0011.ext  : type file
   pfx-0012.ext  : type file
 }
}

def files-condition DIR_CONTENTS_after_nr =
{
 pfx-0008.ext1 : type file
 pfx-0008.ext2 : type file
 pfx-0009.ext1 : type file
 pfx-0009.ext2 : type file
 a : @[SUB_DIR_A_CONTENTS_MATCHES_before]@
}
