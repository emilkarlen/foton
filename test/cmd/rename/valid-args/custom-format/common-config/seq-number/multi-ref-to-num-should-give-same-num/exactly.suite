[cases]

*.case

[setup]

including ../common.xly

def list FORMAT_ARGS = --format '{NN}-{NN}'

dir @[DIR]@ = @[COMMON_DIR_CONTENTS]@


[assert]

exit-code == 0

stderr is-empty

stdout equals @[REPORT]@


[before-assert]

def string REPORT =
<<EOF
@[DIR]@: a.ext1 -> 1-1.ext1
@[DIR]@: a.ext2 -> 1-1.ext2
@[DIR]@: b.ext1 -> 2-2.ext1
@[DIR]@: b.ext2 -> 2-2.ext2
@[DIR]@/a: a.ext1 -> 3-3.ext1
@[DIR]@/a: b.ext -> 4-4.ext
@[DIR]@/a: c.ext -> 5-5.ext
EOF

def files-condition DIR_CONTENTS_after =
{
 1-1.ext1 : type file
 1-1.ext2 : type file
 2-2.ext1 : type file
 2-2.ext2 : type file
 a : type dir && dir-contents matches -full
 {
   3-3.ext1 : type file
   4-4.ext  : type file
   5-5.ext  : type file
 }
}
