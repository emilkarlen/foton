[cases]

*.case

[setup]

including ../common.xly

[setup]

def list EXT_FILTER_OPTS_short = -i 'ext1' -i 'ext2'
def list EXT_FILTER_OPTS_long  = -i 'ext2.ext3' -i 'ext3.ext4'

[before-assert]

def file-matcher DIR_W_RENAMED_FILES_short =
  type dir && dir-contents matches -full
    {
      @[FN_A_E1_rn_short]@ : type file && contents equals @[FN_A_E1]@
      @[FN_A_E2_rn_short]@ : type file && contents equals @[FN_A_E2]@
      @[FN_A_E3]@          : type file && contents equals @[FN_A_E3]@
      @[FN_A_E4]@          : type file && contents equals @[FN_A_E4]@
    }

def string REPORT_short =
<<EOF
@[DIR]@: @[FN_A_E1]@ -> @[FN_A_E1_rn_short]@
@[DIR]@: @[FN_A_E2]@ -> @[FN_A_E2_rn_short]@
EOF

def file-matcher DIR_W_RENAMED_FILES_long =
  type dir && dir-contents matches -full
    {
      @[FN_A_E2]@         : type file && contents equals @[FN_A_E2]@
      @[FN_A_E1]@         : type file && contents equals @[FN_A_E1]@
      @[FN_A_E3_rn_long]@ : type file && contents equals @[FN_A_E3]@
      @[FN_A_E4_rn_long]@ : type file && contents equals @[FN_A_E4]@
    }

def string REPORT_long =
<<EOF
@[DIR]@: @[FN_A_E3]@ -> @[FN_A_E3_rn_long]@
@[DIR]@: @[FN_A_E4]@ -> @[FN_A_E4_rn_long]@
EOF

[assert]

exit-code == 0

stderr is-empty
