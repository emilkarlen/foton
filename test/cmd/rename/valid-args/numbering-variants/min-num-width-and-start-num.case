[act]

@ BIN_EXE -r --min-num-width 3 --start-num 7 @[DIR]@

[setup]

def string DIR = the-dir

dir @[DIR]@ =
{
  file a.ext1
  file a.ext2
  file b.ext
  dir a =
  {
    file a.ext1
    file b.ext
    file c.ext
  }
}

[assert]

stdout equals @[REPORT]@

dir-contents . : matches -full
{
  @[DIR]@ : type dir && dir-contents matches -full @[DIR_CONTENTS_AFTER_RENAME]@
}

[before-assert]

def string REPORT =
<<EOF
@[DIR]@: a.ext1 -> 007.ext1
@[DIR]@: a.ext2 -> 007.ext2
@[DIR]@: b.ext -> 008.ext
@[DIR]@/a: a.ext1 -> 009.ext1
@[DIR]@/a: b.ext -> 010.ext
@[DIR]@/a: c.ext -> 011.ext
EOF

def files-condition DIR_CONTENTS_AFTER_RENAME =
{
 007.ext1 : type file
 007.ext2 : type file
 008.ext  : type file
 a : type dir && dir-contents matches -full
 {
    009.ext1 : type file
    010.ext  : type file
    011.ext  : type file
 }
}
