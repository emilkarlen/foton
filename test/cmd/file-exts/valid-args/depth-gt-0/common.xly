including ../common.xly


[assert]

exit-code == 0
stderr is-empty


[setup]

def string DIR = the-dir

dir @[DIR]@ =
{
  file a.root

  dir sub-1 =
  {
    file a.sub1
    dir sub-12 =
    {
      file a.sub12
      dir sub-3 = { file b.sub123 }
    }
  }

  dir sub-2 =
  {
    file a.sub2
    file b.sub2
    dir sub-22 =
    {
      file b.sub22
      file c.sub22
      dir sub-22 = { file b.sub221 }
    }
  }
}


[before-assert]

def string INDENT = "  "
def string INDENT_0 = @[INDENT]@
def string INDENT_1 = @[INDENT_0]@@[INDENT]@
def string INDENT_2 = @[INDENT_1]@@[INDENT]@
